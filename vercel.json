{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/deon",
      "destination": "/"
    },
    {
      "source": "/deon/api/stats",
      "destination": "/api/stats"
    },
    {
      "source": "/api/newsletter",
      "destination": "/api/stats?route=newsletter"
    },
    {
      "source": "/api/instantdm-webhook",
