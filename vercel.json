    },
    {
      "source": "/api/issues",
      "destination": "/api/stats?route=issues"
    },
    {
      "source": "/api/backfill-preview",
      "destination": "/api/stats?route=backfill-preview"
    },
    {
      "source": "/deon/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/go/:automation/:index",
      "destination": "/api/go?automation=:automation&index=:index"
    }
